# ─── ocs-api .env ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Used by docker-compose.yml (env_file) to inject variables into the container.
# Spring Boot reads these as environment variables (${VAR} in application.yml).
#
# For local development WITHOUT Docker:
#   These defaults are already baked into application.yml, so you don't need
#   this file at all — just run: ./mvnw spring-boot:run (or mvn spring-boot:run)

# ── Database ────────────────────────────────────────────────────────────────────
# Docker container database configuration (commented out)
# DB_URL=jdbc:postgresql://postgres:5432/ocs_db
# DB_USERNAME=ocs_user
# DB_PASSWORD=ocs_password

# Local database configurations
DB_URL=jdbc:postgresql://localhost:5432/ocs_db
DB_USERNAME=ocs_user
DB_PASSWORD=ocs_password

# ── Calculator service ──────────────────────────────────────────────────────────
# Docker container calculator configuration (commented out)
# CALCULATOR_URL=http://ocs-calculator:8081

# Local calculator configurations
CALCULATOR_URL=http://localhost:8081

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate a strong 256-bit base64-encoded secret for production
JWT_SECRET=change-this-to-a-strong-256-bit-secret-in-production
JWT_EXPIRATION_MS=86400000

# ── Server ──────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
