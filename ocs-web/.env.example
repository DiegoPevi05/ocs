# ─── ocs-web .env template ────────────────────────────────────────────────────
# For local dev: Vite reads .env.development automatically — no copy needed.
# For production Docker build: copy to .env.production and set real values,
#   OR pass VITE_API_BASE_URL / VITE_WS_URL as build args in docker-compose.yml.
#
# IMPORTANT: All VITE_ vars are baked into the bundle at build time.
#            Do NOT put secrets here — they will be visible in the browser.

VITE_API_BASE_URL=http://your-api-host:8080
VITE_WS_URL=ws://your-api-host:8080
