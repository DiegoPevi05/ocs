# ─── Root .env — Docker Compose level variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is used by docker-compose.yml for ${VAR} interpolation.

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_DB=ocs_db
POSTGRES_USER=ocs_user
POSTGRES_PASSWORD=ocs_password

# ── Frontend build args (baked into the Vite bundle at build time) ──────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
